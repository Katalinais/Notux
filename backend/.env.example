# Copy to .env and fill in. Never commit .env.

# --- Server ---------------------------------------------------------------
# development | production | test
NODE_ENV=development
PORT=3000
# Comma-separated frontend origins allowed by CORS and as post-login redirect targets.
# An entry may include a path (e.g. https://usuario.github.io/notux/) to restrict redirects to it.
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Set when running behind a reverse proxy (Render, Railway, Fly): true, a hop count like 1, or "loopback".
TRUST_PROXY=false
# Serve the Swagger UI at /docs (true/false).
SWAGGER_ENABLED=true

# --- Database (docker compose up -d gives you this one) ---------------------
DATABASE_URL=postgresql://notux:notux@localhost:5432/notux?schema=public

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ----
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be listed exactly as an "Authorized redirect URI" of the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Secrets ----------------------------------------------------------------
# Signs access tokens (JWT, HS256). At least 32 characters: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# AES-256-GCM key for Google refresh tokens and the OAuth state. 32 bytes, base64: openssl rand -base64 32
# Changing it invalidates stored Google tokens (users just log in again).
TOKEN_ENCRYPTION_KEY=

# --- Optional tuning ----------------------------------------------------------
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
