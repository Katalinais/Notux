{
  "name": "notux",
  "version": "0.1.0",
  "private": true,
  "description": "Notux: tareas, notas y horario en una PWA que funciona sin conexión.",
  "type": "module",
  "scripts": {
    "start": "http-server . -p 8080 -c-1 -o",
    "mock-api": "node dev/mock-api.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "http-server": "^14.1.1",
    "prettier": "^3.10.1"
  }
}
